{
  "name": "@mttzzz/vue-typecheck",
  "version": "0.1.0",
  "description": "Type-check Vue SFCs with TypeScript 7 (tsc or bun check)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mttzzz/vue-typecheck.git"
  },
  "bin": {
    "vue-typecheck": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@typescript/typescript6": "6.0.2",
    "@vue/language-core": "3.3.13"
  },
  "peerDependencies": {
    "typescript": ">=7.0.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "bun": "1.4.3",
    "typescript": "7.0.2",
    "vue": "3.5.43",
    "vue-tsc": "3.3.13"
  }
}
